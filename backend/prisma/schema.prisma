generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {

  id Int @id @default(autoincrement())

  firebaseUid String? @unique

  email String @unique

  userName String?

  photoURL String?

  phoneNumber String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}